# 本番DBに接続してローカルのAdminを動かす用の環境変数
# このファイルをコピーして .env.production を作成し、本番の値を設定してください
# .env.production は .gitignore で除外されているため、コミットされません
#
# 使い方: pnpm dev:admin:prod-db

#--- Common ---
# Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# AI Chatの日次コストリミット（USD）
CHAT_DAILY_USER_COST_LIMIT_USD=0.5
CHAT_DAILY_TOTAL_COST_LIMIT_USD=50
CHAT_MONTHLY_TOTAL_COST_LIMIT_USD=1000

# --- Admin ---
NEXT_PUBLIC_WEB_URL=https://<tsushima-web-host>
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=<shared-secret>
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DALLE_MODEL=dall-e-3
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
